// Java Security Policy for RMI Client
// This file grants necessary permissions for the client to run

grant {
    // Allow all permissions for development
    // In production, restrict these permissions
    permission java.security.AllPermission;
    
    // RMI permissions
    permission java.net.SocketPermission "*:1024-65535", "connect,resolve";
    permission java.net.SocketPermission "*:1099", "connect,resolve";
    
    // File permissions (for logs and temp files)
    permission java.io.FilePermission "<<ALL FILES>>", "read,write";
    
    // Property permissions
    permission java.util.PropertyPermission "*", "read";
    
    // Runtime permissions
    permission java.lang.RuntimePermission "*";
    permission java.lang.reflect.ReflectPermission "*";
    
    // AWT/Swing permissions (for GUI)
    permission java.awt.AWTPermission "*";
};
